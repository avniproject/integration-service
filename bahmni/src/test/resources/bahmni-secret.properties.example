# Credentials for running the bahmni *ExternalTest classes against real servers.
#
# Copy this file to bahmni-secret.properties (same folder) and fill in the values.
# bahmni-secret.properties is git-ignored and loaded only if present, so tests that
# don't talk to real servers run fine without it. Never commit real credentials.
#
# Deployed environments do not use this file - set the environment variables
# OPENMRS_BASE_URL / OPENMRS_USER / OPENMRS_PASSWORD and
# BAHMNI_AVNI_API_URL / BAHMNI_AVNI_API_USER / BAHMNI_AVNI_API_PASSWORD instead.

# Bahmni (OpenMRS), e.g. JSS prerelease: https://jss-bahmni-prerelease.avniproject.org
openmrs.uri.prefix=
openmrs.user=
openmrs.password=

# Avni, e.g. prerelease org "JSSCP Training": https://prerelease.avniproject.org:443
bahmni.avni.api.url=
bahmni.avni.impl.username=
bahmni.avni.impl.password=
